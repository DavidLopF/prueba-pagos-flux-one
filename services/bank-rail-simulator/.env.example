# Para correr este servicio fuera de Docker contra la infraestructura de docker compose:
#   docker compose stop bank-rail
#   cp .env.example .env && npm run dev        (.env no se sube al repo)
# 8081 para no chocar con el frontend (8080) y coincidir con el RAIL_BASE_URL de payments fuera de Docker.
PORT=8081
RAIL_P_ACCEPT=0.55
RAIL_P_REJECT=0.15
RAIL_P_UNAVAILABLE=0.15
RAIL_P_TIMEOUT=0.15
RAIL_LOOKUP_P_UNAVAILABLE=0.10
RAIL_LOOKUP_P_TIMEOUT=0.05
RAIL_TIMEOUT_DELAY_MS=15000
