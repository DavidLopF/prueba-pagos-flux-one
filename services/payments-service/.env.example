# Para correr este servicio fuera de Docker contra la infraestructura de docker compose:
#   docker compose up -d postgres rabbitmq bank-rail && docker compose stop payments-service
#   cp .env.example .env && npm run dev        (.env no se sube al repo)
PORT=3002
# Rol payments_user: solo tiene permisos sobre payment_schema.
DATABASE_URL=postgres://payments_user:payments_pass@localhost:55432/payments_portal
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod-0123456789
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Riel simulado publicado por compose en el puerto 8081 del host.
RAIL_BASE_URL=http://localhost:8081
RAIL_TIMEOUT_MS=10000
