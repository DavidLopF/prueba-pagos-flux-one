# Para correr este servicio fuera de Docker contra la infraestructura de docker compose:
#   docker compose up -d postgres rabbitmq bank-rail && docker compose stop auth-service
#   cp .env.example .env && npm run dev        (.env no se sube al repo)
PORT=3001
DATABASE_URL=postgres://auth_user:auth_pass@localhost:55432/payments_portal
# Debe ser el mismo en auth, payments y audit (mínimo 32 caracteres).
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod-0123456789
LOG_LEVEL=info
