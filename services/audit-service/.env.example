# Para correr este servicio fuera de Docker contra la infraestructura de docker compose:
#   docker compose up -d postgres rabbitmq bank-rail && docker compose stop audit-service
#   cp .env.example .env && npm run dev        (.env no se sube al repo)
PORT=3003
# Rol audit_user: solo tiene permisos sobre audit_schema.
DATABASE_URL=postgres://audit_user:audit_pass@localhost:55432/payments_portal
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod-0123456789
RABBITMQ_URL=amqp://guest:guest@localhost:5672
