# Variables que docker-compose.yml interpola. Opcional: sin .env, compose usa los mismos valores por defecto.
#   cp .env.example .env   (docker compose lee .env automáticamente; .env NUNCA se sube al repo)

# Secreto HS256 compartido: auth-service firma los JWT y payments/audit los validan. Mínimo 32 caracteres.
JWT_SECRET=dev-only-jwt-secret-change-me-in-prod-0123456789

# payments-service: tiempo máximo de espera de una respuesta del riel antes de marcar la transferencia UNKNOWN.
RAIL_TIMEOUT_MS=10000

# Riel bancario simulado: pesos relativos de cada respuesta a un POST (se normalizan, no tienen que sumar 1).
RAIL_P_ACCEPT=0.55
RAIL_P_REJECT=0.15
RAIL_P_UNAVAILABLE=0.15
RAIL_P_TIMEOUT=0.15
# Probabilidad de que una consulta GET /rail/transfers/{reference} falle con 503 o no responda.
RAIL_LOOKUP_P_UNAVAILABLE=0.10
RAIL_LOOKUP_P_TIMEOUT=0.05
# Cuánto tarda el riel en contestar cuando simula un timeout (debe ser mayor que RAIL_TIMEOUT_MS).
RAIL_TIMEOUT_DELAY_MS=15000

# --- Solo producción (docker-compose.prod.yml); deploy/bootstrap.sh los genera con valores aleatorios ---
# DOMAIN=3-91-10-20.sslip.io
# POSTGRES_PASSWORD=
# RABBITMQ_USER=portal
# RABBITMQ_PASSWORD=
